<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>전체 게시물 — <%= settings.site_name || '포트폴리오' %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260446">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="inner-page posts-all-page">

  <%- include('partials/inner-header') %>

  <main class="inner-main posts-all-main">
    <div class="posts-all-shell">
      <% if (isAdmin) { %>
        <div class="posts-all-admin">
          <a href="/posts/new" class="admin-action-btn">
            <i class="fas fa-plus"></i> 새 게시물 작성
          </a>
        </div>
      <% } %>

      <header class="posts-all-heading posts-all-heading--split">
        <div class="posts-all-titles">
          <h1 class="posts-all-title-ko">전체 게시물</h1>
          <p class="posts-all-title-ja" lang="ja">すべての投稿</p>
        </div>
        <div class="posts-all-intro" lang="ko">
          <p class="posts-all-intro-line"><%= typeof allPostsIntroKo !== 'undefined' ? allPostsIntroKo : '' %></p>
          <p class="posts-all-intro-line posts-all-intro-line--ja" lang="ja"><%= typeof allPostsIntroJa !== 'undefined' ? allPostsIntroJa : '' %></p>
        </div>
      </header>

      <div class="board-table-wrap posts-all-table-wrap" role="region" aria-label="전체 게시글 목록">
        <table class="board-table posts-all-table">
          <thead>
            <tr>
              <th class="board-th board-th--num" scope="col">번호</th>
              <th class="board-th board-th--title" scope="col">제목</th>
              <th class="board-th board-th--board" scope="col">게시판</th>
              <th class="board-th board-th--author" scope="col">작성자</th>
              <th class="board-th board-th--date" scope="col">작성일</th>
              <th class="board-th board-th--views" scope="col">조회수</th>
            </tr>
          </thead>
          <tbody>
            <% if (posts.length === 0) { %>
              <tr>
                <td class="board-td board-td--empty" colspan="6">게시물이 존재하지 않습니다.</td>
              </tr>
            <% } else { %>
              <% posts.forEach(function (post, idx) { %>
                <% var rowNum = total - ((page - 1) * pageSize) - idx; %>
                <tr class="board-row">
                  <td class="board-td board-td--num"><%= rowNum %></td>
                  <td class="board-td board-td--title">
                    <a href="/posts/<%= post.id %>" class="board-title-link"><%= post.title %></a>
                    <span class="board-comment-count" aria-label="댓글 <%= post.comment_count %>개">[<%= post.comment_count %>]</span>
                  </td>
                  <td class="board-td board-td--board"><%= post.project_name || '—' %></td>
                  <td class="board-td board-td--author"><%= post.author_nickname || '—' %></td>
                  <td class="board-td board-td--date"><time datetime="<%= post.created_at %>"><%= post.display_time %></time></td>
                  <td class="board-td board-td--views"><%= post.view_count %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <nav class="board-pagination posts-all-pagination" aria-label="게시판 페이지">
        <p class="board-pagination-summary">
          전체 <strong><%= totalPages %></strong>페이지
          · 현재 <strong><%= page %></strong>페이지
        </p>
        <div class="board-pagination-pages">
          <% paginationItems.forEach(function (item) { %>
            <% if (item.type === 'ellipsis') { %>
              <span class="board-page-ellipsis" aria-hidden="true">…</span>
            <% } else { %>
              <% if (item.current) { %>
                <span class="board-page-num board-page-num--current" aria-current="page"><%= item.n %></span>
              <% } else { %>
                <a class="board-page-num" href="/posts?page=<%= item.n %>"><%= item.n %></a>
              <% } %>
            <% } %>
          <% }); %>
        </div>
      </nav>
    </div>
  </main>
</body>
</html>
