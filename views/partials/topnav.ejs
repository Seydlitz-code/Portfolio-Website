<nav class="topnav <%= typeof topnavCenterHome !== 'undefined' && topnavCenterHome ? 'topnav--center-home' : '' %>" id="topnav">
  <div class="topnav-inner topnav-bar <%= typeof topnavCenterHome !== 'undefined' && topnavCenterHome ? 'topnav-inner--center-home' : '' %> <%= typeof topnavIndexHeroLink !== 'undefined' && topnavIndexHeroLink ? 'topnav-inner--index-home' : '' %>">
    <% var __nvTitle = ''; if (typeof sitePlainText === 'function' && typeof settings !== 'undefined' && settings && settings.site_name) { __nvTitle = sitePlainText(settings.site_name); } %>
    <% var __nvFallback = 'Donghawan Lee / @lilip'; %>
    <% if (typeof topnavCenterHome !== 'undefined' && topnavCenterHome) { %>
      <a href="/" class="topnav-home-link"><%= __nvTitle || __nvFallback %></a>
    <% } %>
    <% if (typeof topnavIndexHeroLink !== 'undefined' && topnavIndexHeroLink) { %>
      <button type="button" class="topnav-index-home-btn" id="topnavIndexHomeBtn" onclick="scrollToHero(event)" aria-label="메인 화면으로 스크롤">
        <%= __nvTitle || __nvFallback %>
      </button>
    <% } %>
    <div class="topnav-right topnav-right--cluster">
      <%- include('nav-cluster') %>
    </div>
  </div>
</nav>
