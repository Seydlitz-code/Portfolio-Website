<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post ? '게시물 수정' : '새 게시물 작성' %> — <%= settings.site_name || '포트폴리오' %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260515">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="inner-page post-editor-page">

  <%- include('partials/inner-header') %>

  <main class="post-editor-main">
    <div class="post-editor-shell">
      <header class="post-editor-page-head">
        <a href="/posts" class="post-editor-backlink">전체 게시물 보기</a>
        <p class="post-editor-backlink-ja" lang="ja">全ての投稿を表示</p>
        <div class="post-editor-head-rule" aria-hidden="true"></div>
      </header>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="post-editor-alert"><%= error %></div>
      <% } %>

      <form id="postEditorForm" action="<%= formAction %>" method="<%= formMethod %>" class="post-editor-form">
        <% if (!post) { %>
          <input type="hidden" name="_cancel_href" value="<%= typeof cancelHref !== 'undefined' ? cancelHref : '/posts' %>">
        <% } %>
        <div class="post-editor-title-grid">
          <label class="post-editor-field">
            <span class="post-editor-label">제목을 입력해주세요 (국문) <span class="required">*</span></span>
            <input type="text" name="title" id="postTitleKo" class="post-editor-input"
                   value="<%= post ? post.title : '' %>" placeholder="국문 제목" autocomplete="off" required>
          </label>
          <label class="post-editor-field">
            <span class="post-editor-label">제목을 입력해주세요 (일본어)</span>
            <input type="text" name="title_ja" id="postTitleJa" class="post-editor-input"
                   value="<%= post && post.title_ja != null ? post.title_ja : '' %>" placeholder="日本語タイトル" lang="ja" autocomplete="off">
          </label>
        </div>

        <% var _showLockedBoard = !post && typeof projectSelectLocked !== 'undefined' && projectSelectLocked && typeof lockedProject !== 'undefined' && lockedProject; %>
        <div class="post-editor-field post-editor-field--inline">
          <span class="post-editor-label">게시판<% if (!post) { %> <span class="required">*</span><% } %></span>
          <% if (_showLockedBoard) { %>
            <input type="hidden" name="_project_form_locked" value="1">
            <input type="hidden" name="project_id" value="<%= lockedProject.id %>">
            <p class="post-editor-readonly-board" id="postProjectReadonly"><%= lockedProject.name %><% if (lockedProject.name_ja != null && String(lockedProject.name_ja).trim() !== '') { %> <span class="post-editor-readonly-board-ja" lang="ja">(<%= lockedProject.name_ja %>)</span><% } %></p>
          <% } else { %>
            <select name="project_id" id="postProjectId" class="post-editor-select"<%= !post ? ' required' : '' %>>
              <% if (!post) { %>
                <option value="" disabled <% if (typeof defaultProjectId === 'undefined' || defaultProjectId == null) { %>selected<% } %>>게시판을 선택하세요</option>
              <% } else { %>
                <option value=""<%= (!post.project_id) ? ' selected' : '' %>>-- 분류 없음 --</option>
              <% } %>
              <% projects.forEach(p => { %>
                <option value="<%= p.id %>" <%= (post && post.project_id === p.id) || (!post && typeof defaultProjectId !== 'undefined' && defaultProjectId != null && Number(defaultProjectId) === Number(p.id)) ? 'selected' : '' %>>
                  <%= p.name %>
                </option>
              <% }) %>
            </select>
          <% } %>
        </div>

        <div class="post-editor-toolbars">
          <div class="post-editor-toolbar post-editor-toolbar--media" role="toolbar" aria-label="미디어 삽입">
            <button type="button" class="post-editor-toolbtn" id="postEditorBtnImage" title="이미지">
              <i class="fas fa-image" aria-hidden="true"></i><span>이미지</span>
            </button>
            <button type="button" class="post-editor-toolbtn" id="postEditorBtnVideo" title="동영상">
              <i class="fas fa-film" aria-hidden="true"></i><span>동영상</span>
            </button>
            <button type="button" class="post-editor-toolbtn" id="postEditorBtnYoutube" title="YouTube">
              <i class="fab fa-youtube" aria-hidden="true"></i><span>YouTube</span>
            </button>
            <input type="file" id="postEditorFileImage" class="is-hidden" accept="image/jpeg,image/png,image/gif,image/webp" tabindex="-1" aria-hidden="true">
            <input type="file" id="postEditorFileVideo" class="is-hidden" accept="video/mp4,video/webm,video/quicktime" tabindex="-1" aria-hidden="true">
          </div>

          <div class="post-editor-toolbar post-editor-toolbar--format" role="toolbar" aria-label="글자 서식">
            <select id="postEditorFontFamily" class="post-editor-fmt-select" title="글꼴" aria-label="글꼴">
              <option value="">글꼴</option>
              <option value="'Noto Sans KR', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif">본고딕 (Noto Sans KR)</option>
              <option value="'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif">맑은 고딕</option>
              <option value="'Batang', 'BatangChe', Georgia, 'Times New Roman', serif">바탕·명조 계열</option>
              <option value="Georgia, 'Times New Roman', 'Batang', serif">명조 (Georgia)</option>
              <option value="'Gulim', 'Dotum', 'Malgun Gothic', sans-serif">굴림·돋움 계열</option>
              <option value="ui-monospace, 'Consolas', 'Malgun Gothic', monospace">고정폭</option>
            </select>
            <div class="post-editor-fmt-size-wrap" id="postEditorFontSizeWrap">
              <button type="button" id="postEditorFontSizeTrigger" class="post-editor-fmt-size-trigger" aria-haspopup="listbox" aria-expanded="false" title="글자 크기 (px)" aria-label="글자 크기 선택">
                <span class="post-editor-fmt-size-trigger-value" id="postEditorFontSizeValue">10</span>
                <i class="fas fa-chevron-down post-editor-fmt-size-trigger-chevron" aria-hidden="true"></i>
              </button>
              <div id="postEditorFontSizeMenu" class="post-editor-fmt-size-menu is-hidden" role="listbox" aria-label="글자 크기"></div>
            </div>
            <span class="post-editor-fmt-div" aria-hidden="true"></span>
            <button type="button" class="post-editor-fmt-btn" data-cmd="bold" title="굵게 (Ctrl+B)">
              <i class="fas fa-bold" aria-hidden="true"></i>
            </button>
            <button type="button" class="post-editor-fmt-btn" data-cmd="italic" title="기울임 (Ctrl+I)">
              <i class="fas fa-italic" aria-hidden="true"></i>
            </button>
            <button type="button" class="post-editor-fmt-btn" data-cmd="underline" title="밑줄 (Ctrl+U)">
              <i class="fas fa-underline" aria-hidden="true"></i>
            </button>
            <button type="button" class="post-editor-fmt-btn" data-cmd="strikeThrough" title="취소선">
              <i class="fas fa-strikethrough" aria-hidden="true"></i>
            </button>
            <span class="post-editor-fmt-div" aria-hidden="true"></span>
            <div class="post-editor-color-wrap">
              <button type="button" id="postEditorColorBtn" class="post-editor-fmt-color post-editor-fmt-color--trigger"
                      title="글자·배경 색" aria-label="글자·배경 색" aria-expanded="false" aria-haspopup="dialog">
                <span class="post-editor-fmt-color-bar" aria-hidden="true"></span>
                <i class="fas fa-font" aria-hidden="true"></i>
              </button>
              <div id="postEditorColorPanel" class="post-editor-color-panel is-hidden" role="dialog" aria-label="색 선택">
                <div class="post-editor-color-col">
                  <span class="post-editor-color-col-title">배경색</span>
                  <button type="button" class="post-editor-color-preset" data-color-action="bg-transparent">투명으로 설정</button>
                  <div id="postEditorBgGrid" class="post-editor-swatch-grid"></div>
                  <button type="button" class="post-editor-color-more" data-color-more="bg">다른 색상 선택</button>
                </div>
                <div class="post-editor-color-col">
                  <span class="post-editor-color-col-title">글자색</span>
                  <button type="button" class="post-editor-color-preset" data-color-action="fg-black">검은색으로 설정</button>
                  <div id="postEditorFgGrid" class="post-editor-swatch-grid"></div>
                  <button type="button" class="post-editor-color-more" data-color-more="fg">다른 색상 선택</button>
                </div>
              </div>
              <input type="color" id="postEditorFgColorHidden" class="post-editor-color-native" value="#000000" aria-hidden="true" tabindex="-1" title="글자색 직접 선택">
              <input type="color" id="postEditorBgColorHidden" class="post-editor-color-native" value="#ffffff" aria-hidden="true" tabindex="-1" title="배경색 직접 선택">
            </div>
            <span class="post-editor-fmt-div" aria-hidden="true"></span>
            <button type="button" class="post-editor-fmt-btn" data-justify="left" title="왼쪽 정렬">
              <i class="fas fa-align-left" aria-hidden="true"></i>
            </button>
            <button type="button" class="post-editor-fmt-btn" data-justify="center" title="가운데 정렬">
              <i class="fas fa-align-center" aria-hidden="true"></i>
            </button>
            <button type="button" class="post-editor-fmt-btn" data-justify="right" title="오른쪽 정렬">
              <i class="fas fa-align-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div id="postEditorBody" class="post-editor-body" contenteditable="true" spellcheck="true"
             data-placeholder="게시물 본문을 입력하세요. 이미지·동영상은 버튼으로 추가하거나 붙여넣기·드래그 앤 드롭할 수 있습니다."></div>
        <textarea id="postContentHidden" name="content" class="is-hidden" aria-hidden="true" tabindex="-1"></textarea>

        <div class="post-editor-actions">
          <a href="<%= post ? '/posts/' + post.id : (typeof cancelHref !== 'undefined' && cancelHref ? cancelHref : '/posts') %>" class="post-editor-btn post-editor-btn--ghost">취소</a>
          <button type="submit" class="post-editor-btn post-editor-btn--primary">
            <%= post ? '수정 완료' : '등록' %>
          </button>
        </div>
      </form>
    </div>
  </main>

  <dialog id="postYtDialog" class="post-editor-dialog">
    <div class="post-editor-dialog-inner">
      <h2 class="post-editor-dialog-title">YouTube 링크</h2>
      <p class="post-editor-dialog-hint">영상 URL을 붙여넣은 뒤 적용을 누르면 본문에 플레이어와 링크가 함께 들어갑니다.</p>
      <input type="url" id="postYtInput" class="post-editor-input" placeholder="https://www.youtube.com/watch?v=…">
      <div class="post-editor-dialog-actions">
        <button type="button" class="post-editor-btn post-editor-btn--ghost" id="postYtCancel">닫기</button>
        <button type="button" class="post-editor-btn post-editor-btn--primary" id="postYtApply">적용</button>
      </div>
    </div>
  </dialog>

  <input type="hidden" id="post-editor-init-b64" value="<%= typeof editorInitJsonB64 !== 'undefined' ? editorInitJsonB64 : '' %>">

  <script src="/js/post-editor.js?v=20260514" defer></script>
</body>
</html>
