<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>회원가입 — 포트폴리오</title>
  <link rel="stylesheet" href="/css/style.css?v=20260427">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="auth-page auth-page--register">
  <div class="auth-container">
    <div class="auth-card auth-card--register">
      <a href="/auth/login" class="auth-back"><span>←</span> 뒤로 가기</a>
      <h1 class="auth-title">회원가입</h1>
      <p class="auth-sub">새 계정을 만들어서 댓글을 남겨보세요.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/auth/register" method="POST" class="auth-form register-form" id="registerForm" novalidate enctype="multipart/form-data">
        <div class="register-grid">
          <div class="register-col register-col--avatar">
            <div class="register-avatar-preview-wrap">
              <div class="register-avatar-preview" id="registerAvatarPreview" aria-hidden="true"></div>
            </div>
            <p class="register-avatar-label">프로필 이미지 설정</p>
            <input type="file" id="registerAvatarFile" accept="image/jpeg,image/png,image/gif,image/webp" hidden>
            <button type="button" class="register-avatar-select-btn" id="btnSelectAvatar">이미지 선택</button>
          </div>

          <div class="register-col register-col--fields">
            <div class="form-group">
              <label class="form-label" for="username">아이디 <span class="required">*</span></label>
              <div class="register-dup-row">
                <input type="text" id="username" name="username" class="form-input register-dup-input"
                       placeholder="영문, 숫자, 밑줄(_)만 사용 (3자 이상)" required
                       pattern="[a-zA-Z0-9_]+" minlength="3" maxlength="30" autocomplete="username">
                <button type="button" class="nav-btn register-dup-btn" id="btnCheckUsername" title="아이디 사용 가능 여부">
                  중복 확인
                </button>
                <span class="dup-check-msg" id="usernameCheckMsg" aria-live="polite"></span>
              </div>
              <small class="form-hint">영문, 숫자, 밑줄(_)만 사용 가능합니다.</small>
            </div>

            <div class="form-group">
              <label class="form-label" for="password">비밀번호 <span class="required">*</span></label>
              <div class="password-wrap">
                <input type="password" id="password" name="password" class="form-input"
                       placeholder="8자 이상" required minlength="8" autocomplete="new-password">
                <button type="button" class="pw-toggle" aria-label="비밀번호 표시" onclick="togglePw('password')">👁</button>
              </div>
              <small class="form-hint">최소 8자 이상이어야 합니다.</small>
            </div>

            <div class="form-group">
              <label class="form-label" for="passwordConfirm">비밀번호 확인 <span class="required">*</span></label>
              <div class="password-wrap">
                <input type="password" id="passwordConfirm" name="passwordConfirm" class="form-input"
                       placeholder="비밀번호를 다시 입력하세요" required autocomplete="new-password">
                <button type="button" class="pw-toggle" aria-label="비밀번호 표시" onclick="togglePw('passwordConfirm')">👁</button>
              </div>
              <small id="pwMatchMsg" class="form-hint"></small>
            </div>
          </div>

          <div class="register-span-row register-nickname-block">
            <div class="form-group">
              <label class="form-label" for="nickname">닉네임 <span class="required">*</span></label>
              <div class="register-dup-row">
                <input type="text" id="nickname" name="nickname" class="form-input register-dup-input"
                       placeholder="닉네임을 입력하세요" required maxlength="20" autocomplete="nickname">
                <button type="button" class="nav-btn register-dup-btn" id="btnCheckNickname" title="닉네임 사용 가능 여부">
                  닉네임 중복 확인
                </button>
                <span class="dup-check-msg" id="nicknameCheckMsg" aria-live="polite"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="form-group captcha-group">
          <label class="form-label">로봇 방지 <span class="required">*</span></label>
          <div class="captcha-box">
            <span class="captcha-question" id="registerCaptchaQuestion"><%= captchaQuestion %></span>
            <input type="number" name="captcha" id="registerCaptchaInput" class="form-input captcha-input" placeholder="답을 입력하세요" required>
          </div>
        </div>

        <div id="registerClientError" class="register-top-error" role="alert" hidden></div>

        <div class="register-submit-row">
          <button type="submit" class="btn-primary register-submit-btn">회원가입</button>
        </div>
      </form>

      <p class="auth-switch">이미 계정이 있으신가요? <a href="/auth/login">로그인</a></p>
    </div>
  </div>

  <div id="registerCropModal" class="register-crop-modal" hidden role="dialog" aria-modal="true" aria-labelledby="registerCropTitle">
    <div id="registerCropBackdrop" class="register-crop-backdrop" aria-hidden="true"></div>
    <div class="register-crop-panel" role="document">
      <header class="register-crop-header">
        <button type="button" class="register-crop-iconbtn" id="registerCropClose" aria-label="닫기">×</button>
        <h2 class="register-crop-title" id="registerCropTitle">이미지 편집하기</h2>
        <button type="button" class="register-crop-iconbtn register-crop-iconbtn--ok" id="registerCropConfirm" aria-label="확인">✓</button>
      </header>
      <div class="register-crop-body">
        <canvas id="registerCropCanvas" class="register-crop-canvas"></canvas>
      </div>
      <footer class="register-crop-footer">
        <button type="button" class="btn-primary register-crop-footer-btn" id="registerCropConfirmBar">확인</button>
      </footer>
    </div>
  </div>

  <script src="/js/register-crop.js?v=20260427"></script>
  <script src="/js/register.js?v=20260427"></script>
</body>
</html>
