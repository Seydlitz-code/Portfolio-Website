<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>마이페이지 — 포트폴리오</title>
  <link rel="stylesheet" href="/css/style.css?v=20260511">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Inter:wght@300;400;500;700&display=swap" rel="stylesheet">
  <% if (typeof isAdmin !== 'undefined' && isAdmin && (activeTab === 'boardsManage' || activeTab === 'mainSettings')) { %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <% } %>
</head>
<body class="mypage-account-page">
  <%- include('partials/topnav', { topnavCenterHome: true }) %>

  <div class="mypage-account-layout">
    <aside class="mypage-account-sidebar" aria-label="마이페이지 메뉴">
      <div class="mypage-account-sidebar-inner">
        <p class="mypage-account-sidebar-label">마이페이지</p>
        <%- include('partials/mypage-account-nav') %>
      </div>
    </aside>

    <div class="mypage-account-stage">
      <header class="mypage-account-stage-header">
        <h1 class="mypage-account-title"><%= headerNickname %> / @<%= profileUser.username %></h1>
      </header>

      <main class="mypage-account-main">
        <% if (activeTab === 'profile') { %>
          <% if (typeof saved !== 'undefined' && saved) { %>
            <div class="mypage-account-alert"><div class="alert alert-success">적용이 완료되었습니다.</div></div>
          <% } %>
          <% if (typeof profileError !== 'undefined' && profileError) { %>
            <div class="mypage-account-alert"><div class="alert alert-error"><%= profileError %></div></div>
          <% } %>

          <div class="mypage-profile-head">
            <h2 class="mypage-profile-section-title">프로필 설정 및 변경</h2>
            <button type="submit" form="mypageAccountForm" class="btn-primary mypage-account-apply" id="mypageAccountApply" disabled>적용하기</button>
          </div>

          <form id="mypageAccountForm" class="mypage-account-form" action="/mypage/profile" method="POST" enctype="multipart/form-data">
            <div class="mypage-profile-avatar-block">
              <div class="mypage-profile-avatar-preview-wrap">
                <img src="<%= profileUser.avatar || '' %>" alt="" class="mypage-profile-avatar-img<%= profileUser.avatar ? '' : ' is-hidden' %>" id="mypageAccountAvatarImg" width="160" height="160" decoding="async">
                <div class="mypage-profile-avatar-placeholder<%= profileUser.avatar ? ' is-hidden' : '' %>" id="mypageAccountAvatarPlaceholder" aria-hidden="true">
                  <%= profileUser.nickname && profileUser.nickname.length ? profileUser.nickname.charAt(0) : '?' %>
                </div>
              </div>
              <div class="mypage-profile-avatar-side">
                <p class="mypage-profile-avatar-label">프로필 이미지 설정</p>
                <input type="file" id="mypageAccountAvatarFile" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp" hidden>
                <button type="button" class="register-avatar-select-btn" id="mypageAccountBtnSelectAvatar">이미지 선택</button>
              </div>
            </div>

            <div class="form-group mypage-profile-nick-group">
              <label class="form-label" for="mypageAccountNickname">닉네임 <span class="required">*</span></label>
              <div class="register-input-line">
                <input type="text" id="mypageAccountNickname" name="nickname" class="form-input" required maxlength="20" autocomplete="nickname"
                       value="<%= profileUser.nickname %>">
              </div>
              <div class="register-dup-btn-row">
                <button type="button" class="nav-btn register-dup-btn" id="mypageAccountBtnCheckNick">닉네임 중복 확인</button>
              </div>
              <small id="mypageAccountNickHint" class="form-hint register-field-hint" aria-live="polite">닉네임을 수정한 경우 「닉네임 중복 확인」을 누른 뒤 적용해 주세요.</small>
              <% if (typeof nicknameDupWarning !== 'undefined' && nicknameDupWarning) { %>
                <p class="mypage-nick-warn" id="mypageAccountNickWarn" role="alert">닉네임 중복 확인을 해주세요.</p>
              <% } else { %>
                <p class="mypage-nick-warn is-hidden" id="mypageAccountNickWarn" role="alert"></p>
              <% } %>
            </div>
          </form>
        <% } else if (activeTab === 'posts') { %>
          <div class="mypage-writings">
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <section class="mypage-writings-block" aria-labelledby="mypageWritingsPostsTitle">
              <h2 class="mypage-writings-title" id="mypageWritingsPostsTitle">작성한 게시물 (<%= typeof myPostsTotal !== 'undefined' ? myPostsTotal : 0 %>)</h2>
              <div class="mypage-writings-divider" role="presentation"></div>
              <% if (!myPosts || myPosts.length === 0) { %>
                <p class="mypage-writings-empty-plain" id="myPostsEmpty">작성한 게시글이 없습니다.</p>
                <ul class="mypage-writings-list is-hidden" id="myPostsList" aria-label="게시글 목록"></ul>
              <% } else { %>
                <div class="mypage-writings-panel mypage-writings-panel--cards">
                  <ul class="mypage-writings-list mypage-writings-list--stacked" id="myPostsList">
                    <% myPosts.forEach(function (post) { %>
                      <% var _ncc = post.comment_count != null ? Number(post.comment_count) : 0; if (!Number.isFinite(_ncc)) _ncc = 0; %>
                      <% var _pko = String(post.title || '').trim(); %>
                      <% var _pja = post.title_ja != null ? String(post.title_ja).trim() : ''; %>
                      <% var _bn = post.project_name != null && String(post.project_name).trim() !== '' ? String(post.project_name).trim() : '분류 없음'; %>
                      <% var _bnJa = post.project_name_ja != null && String(post.project_name_ja).trim() !== '' ? String(post.project_name_ja).trim() : '未分類'; %>
                      <% var _tn = typeof mypageWritingsNext !== 'undefined' ? mypageWritingsNext : '/mypage/posts'; %>
                      <li class="mypage-writings-card mypage-writings-card--post">
                        <div class="mypage-writings-row-top">
                          <a href="/posts/<%= post.id %>" class="mypage-writings-heading-link">
                            <span class="mypage-writings-title-ko"><%= _pko %></span>
                            <% if (_pja !== '') { %>
                              <span class="mypage-writings-title-sep" aria-hidden="true"> / </span>
                              <span class="mypage-writings-title-ja" lang="ja"><%= _pja %></span>
                            <% } %>
                            <span class="mypage-writings-meta-bracket">[<%= _ncc %>]</span>
                          </a>
                        </div>
                        <div class="mypage-writings-row-bottom">
                          <div class="mypage-writings-bottom-left">
                            <span class="mypage-writings-board-line">
                              <span><%= _bn %></span>
                              <span class="mypage-writings-title-sep" aria-hidden="true"> / </span>
                              <span lang="ja"><%= _bnJa %></span>
                            </span>
                            <time class="mypage-writings-bottom-time" datetime="<%= post.created_at %>"><%= formatListTime(post.created_at) %></time>
                          </div>
                          <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="mypage-comment-delete-form mypage-writings-delete-form" onsubmit="return confirm('정말로 삭제하시겠습니까?');">
                            <input type="hidden" name="next" value="<%= _tn %>">
                            <button type="submit" class="mypage-comment-delete-btn" aria-label="게시글 삭제">삭제</button>
                          </form>
                        </div>
                      </li>
                    <% }); %>
                  </ul>
                  <%- include('partials/mypage-writings-pager', { pager: typeof myPostsPager !== 'undefined' ? myPostsPager : [], pagerAria: '작성한 게시물 페이지' }) %>
                </div>
              <% } %>
            </section>
            <% } %>

            <section class="mypage-writings-block" aria-labelledby="mypageWritingsCommentsTitle">
              <h2 class="mypage-writings-title" id="mypageWritingsCommentsTitle">댓글 (<%= typeof myCommentsTotal !== 'undefined' ? myCommentsTotal : 0 %>)</h2>
              <div class="mypage-writings-divider" role="presentation"></div>
              <% if (!myComments || myComments.length === 0) { %>
                <p class="mypage-writings-empty-plain" id="myCommentsEmpty">작성한 댓글이 없습니다.</p>
                <ul class="mypage-writings-list is-hidden" id="myCommentsList" aria-label="댓글 목록"></ul>
              <% } else { %>
                <div class="mypage-writings-panel mypage-writings-panel--cards">
                  <ul class="mypage-writings-list mypage-writings-list--stacked" id="myCommentsList">
                    <% myComments.forEach(function (c) { %>
                      <% var _pt = String(c.post_title || '').trim(); %>
                      <% var _ptJa = c.post_title_ja != null ? String(c.post_title_ja).trim() : ''; %>
                      <% var _tn = typeof mypageWritingsNext !== 'undefined' ? mypageWritingsNext : '/mypage/posts'; %>
                      <% var _clamp = c.preview_two_line ? 'mypage-writings-comment-preview is-clamp-2' : 'mypage-writings-comment-preview'; %>
                      <li class="mypage-writings-card mypage-writings-card--comment">
                        <div class="mypage-writings-row-top">
                          <p class="<%= _clamp %>"><%= c.preview_text %></p>
                          <time class="mypage-writings-row-time" datetime="<%= c.created_at %>"><%= formatListTime(c.created_at) %></time>
                        </div>
                        <div class="mypage-writings-row-bottom">
                          <a href="/posts/<%= c.post_id %>#comments" class="mypage-writings-post-ref">
                            <span class="mypage-writings-title-ko"><%= _pt %></span>
                            <% if (_ptJa !== '') { %>
                              <span class="mypage-writings-title-sep" aria-hidden="true"> / </span>
                              <span class="mypage-writings-title-ja" lang="ja"><%= _ptJa %></span>
                            <% } %>
                          </a>
                          <form action="/posts/<%= c.post_id %>/comments/<%= c.id %>?_method=DELETE" method="POST" class="mypage-comment-delete-form mypage-writings-delete-form" onsubmit="return confirm('정말로 삭제하시겠습니까?');">
                            <input type="hidden" name="next" value="<%= _tn %>">
                            <button type="submit" class="mypage-comment-delete-btn" aria-label="댓글 삭제">삭제</button>
                          </form>
                        </div>
                      </li>
                    <% }); %>
                  </ul>
                  <%- include('partials/mypage-writings-pager', { pager: typeof myCommentsPager !== 'undefined' ? myCommentsPager : [], pagerAria: '작성한 댓글 페이지' }) %>
                </div>
              <% } %>
            </section>
          </div>
        <% } else if (activeTab === 'mainSettings') { %>
          <% if (typeof saved !== 'undefined' && saved) { %>
            <div class="mypage-account-alert"><div class="alert alert-success">적용이 완료되었습니다.</div></div>
          <% } %>
          <% if (typeof errMessage !== 'undefined' && errMessage) { %>
            <div class="mypage-account-alert"><div class="alert alert-error"><%= errMessage %></div></div>
          <% } %>

          <div class="mypage-profile-head">
            <h2 class="mypage-profile-section-title">메인 페이지 설정</h2>
            <button type="submit" form="mypageMainSettingsForm" class="btn-primary mypage-account-apply">적용하기</button>
          </div>

          <form id="mypageMainSettingsForm" class="mypage-account-form" action="/admin/apply" method="POST" enctype="multipart/form-data">
            <section class="mypage-main-settings-hero">
              <div class="mypage-main-settings-avatar-col">
                <div class="profile-circle-wrap mypage-main-settings-circle">
                  <img id="mypageMainProfilePreview" class="profile-img" alt=""
                       src="<%= settings.profile_image || '' %>"
                       style="<%= settings.profile_image ? '' : 'display:none' %>">
                  <div class="profile-placeholder" id="mypageMainNoImg" style="<%= settings.profile_image ? 'display:none' : 'display:flex' %>">
                    <i class="fas fa-user" aria-hidden="true"></i>
                    <span class="placeholder-hint">프로필 이미지</span>
                  </div>
                </div>
                <input type="file" name="profile_image" id="mypageMainFileInput" accept="image/jpeg,image/png,image/gif,image/webp" hidden>
                <button type="button" class="register-avatar-select-btn" id="mypageMainBtnSelectImage">이미지 선택</button>
              </div>
              <div class="mypage-main-settings-fields">
                <div class="form-group">
                  <label class="form-label" for="mypageMainSiteName">메인 페이지 표기 이름</label>
                  <input type="text" name="site_name" id="mypageMainSiteName" class="form-input" required
                         value="<%= settings.site_name || 'Donghawan Lee / @lilip' %>">
                </div>
                <div class="form-group">
                  <label class="form-label" for="mypageMainBio">자기소개 · 이력</label>
                  <textarea name="bio" id="mypageMainBio" class="form-input" rows="10" placeholder="내용을 입력하세요."><%= settings.bio || '' %></textarea>
                </div>
              </div>
            </section>
          </form>
        <% } else if (activeTab === 'boardsManage') { %>
          <% if (typeof boardsSaved !== 'undefined' && boardsSaved) { %>
            <div class="mypage-account-alert"><div class="alert alert-success">게시판이 생성되었습니다.</div></div>
          <% } %>
          <% if (typeof boardsDeleted !== 'undefined' && boardsDeleted) { %>
            <div class="mypage-account-alert"><div class="alert alert-success">게시판이 삭제되었습니다.</div></div>
          <% } %>

          <% if (typeof boardsEditSaved !== 'undefined' && boardsEditSaved) { %>
            <div class="mypage-account-alert"><div class="alert alert-success">게시판 정보가 수정되었습니다.</div></div>
          <% } %>
          <% if (typeof boardsEditErr !== 'undefined' && boardsEditErr) { %>
            <div class="mypage-account-alert"><div class="alert alert-error">게시판 수정에 실패했습니다. 필수 항목을 확인해 주세요.</div></div>
          <% } %>

          <div class="mypage-boards-head">
            <h2 class="mypage-profile-section-title mypage-boards-head-title">게시판 전체 보기</h2>
            <div class="mypage-boards-head-actions">
              <button type="button" class="admin-action-btn admin-action-btn--outline" onclick="openCreateBoardModal()"><i class="fas fa-folder-plus"></i> 게시판 생성하기</button>
            </div>
          </div>

          <div class="board-table-wrap mypage-boards-table-wrap" role="region" aria-label="게시판 목록">
            <table class="board-table mypage-boards-table">
              <thead>
                <tr>
                  <th class="board-th mypage-boards-th-title" scope="col">게시판</th>
                  <th class="board-th mypage-boards-th-count" scope="col">게시물 수</th>
                  <th class="board-th mypage-boards-th-actions" scope="col">수정·삭제</th>
                </tr>
              </thead>
              <tbody>
                <tr class="board-row board-row--all-posts">
                  <td class="board-td mypage-boards-td-title">
                    <a href="/posts" class="board-title-link board-title-link--all-posts">전체 게시물 <span class="board-title-sep" aria-hidden="true">/</span> <span lang="ja">すべての投稿</span></a>
                  </td>
                  <td class="board-td mypage-boards-td-count"><%= typeof boardsAllPostsCount !== 'undefined' ? boardsAllPostsCount : 0 %></td>
                  <td class="board-td mypage-boards-td-actions">
                    <div class="mypage-boards-action-cell" role="group" aria-label="전체 게시물 관리">
                      <a href="/posts" class="mypage-boards-edit" aria-label="전체 게시물 수정·관리"><i class="fas fa-pen" aria-hidden="true"></i><span class="mypage-boards-edit-label">수정하기</span></a>
                      <span class="mypage-boards-no-del" aria-hidden="true">—</span>
                    </div>
                  </td>
                </tr>
                <% if (!boardsList || boardsList.length === 0) { %>
                  <tr>
                    <td class="board-td board-td--empty" colspan="3">등록된 게시판이 없습니다.</td>
                  </tr>
                <% } else { %>
                  <% boardsList.forEach(function (b) { %>
                    <% var _label = (b.name || '') + (b.name_ja ? ' / ' + b.name_ja : ''); var _pc = Number(b.post_count) || 0; %>
                    <tr class="board-row">
                      <td class="board-td mypage-boards-td-title">
                        <a href="/boards/<%= b.id %>" class="board-title-link"><%= b.name %><% if (b.name_ja) { %> / <%= b.name_ja %><% } %></a>
                      </td>
                      <td class="board-td mypage-boards-td-count"><%= _pc %></td>
                      <td class="board-td mypage-boards-td-actions">
                        <div class="mypage-boards-action-cell" role="group" aria-label="<%= _label %> 관리">
                          <button
                            type="button"
                            class="mypage-boards-edit"
                            data-board-edit="<%= b.id %>"
                            data-name="<%= encodeURIComponent(b.name || '') %>"
                            data-name-ja="<%= encodeURIComponent(b.name_ja || '') %>"
                            data-description="<%= encodeURIComponent(b.description || '') %>"
                            aria-label="<%= _label %> 수정">
                            <i class="fas fa-pen" aria-hidden="true"></i><span class="mypage-boards-edit-label">수정하기</span>
                          </button>
                          <button type="button" class="mypage-boards-trash" data-board-delete="<%= b.id %>" data-post-count="<%= _pc %>" aria-label="<%= _label %> 삭제">
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <nav class="board-pagination mypage-boards-pagination" aria-label="게시판 목록 페이지">
            <p class="board-pagination-summary">
              전체 <strong><%= boardsTotalPages %></strong>페이지
              · 현재 <strong><%= boardsPage %></strong>페이지
            </p>
            <div class="board-pagination-pages">
              <% (typeof boardsPaginationItems !== 'undefined' && boardsPaginationItems ? boardsPaginationItems : []).forEach(function (item) { %>
                <% if (item.type === 'ellipsis') { %>
                  <span class="board-page-ellipsis" aria-hidden="true">…</span>
                <% } else { %>
                  <% if (item.current) { %>
                    <span class="board-page-num board-page-num--current" aria-current="page"><%= item.n %></span>
                  <% } else { %>
                    <a class="board-page-num" href="/mypage/boards?page=<%= item.n %>"><%= item.n %></a>
                  <% } %>
                <% } %>
              <% }); %>
            </div>
          </nav>

          <form id="mypageBoardDeleteForm" method="POST" action="" style="display:none">
            <input type="hidden" name="_method" value="DELETE">
          </form>

          <div id="createBoardModal" class="modal-overlay" style="display:none" onclick="closeModalOnOverlay(event, 'createBoardModal')">
            <div class="modal-box modal-box--boards-create" onclick="event.stopPropagation()">
              <button type="button" class="mypage-boards-modal-back" onclick="closeCreateBoardModal()">뒤로 가기</button>
              <h3 class="mypage-boards-modal-title">게시판 생성하기</h3>
              <p id="createBoardFormError" class="mypage-boards-form-error" role="alert"></p>
              <form id="createBoardForm" action="/admin/projects" method="POST">
                <div class="form-group">
                  <label class="form-label" for="createBoardNameKo">게시판 이름 입력 (국문) <span class="required">*</span></label>
                  <input type="text" id="createBoardNameKo" name="name" class="form-input" maxlength="120" autocomplete="off">
                </div>
                <div class="form-group">
                  <label class="form-label" for="createBoardNameJa">게시판 이름 입력 (일본어) <span class="required">*</span></label>
                  <input type="text" id="createBoardNameJa" name="name_ja" class="form-input" maxlength="120" autocomplete="off">
                </div>
                <div class="form-group">
                  <label class="form-label" for="createBoardDesc">게시판에 대한 간단한 소개문 <span class="required">*</span></label>
                  <textarea id="createBoardDesc" name="description" class="form-input" rows="4" maxlength="2000"></textarea>
                </div>
                <div class="mypage-boards-modal-submit-wrap">
                  <button type="submit" class="btn-primary mypage-boards-submit-wide">게시판 생성하기</button>
                </div>
              </form>
            </div>
          </div>

          <div id="editBoardModal" class="modal-overlay" style="display:none" onclick="closeModalOnOverlay(event, 'editBoardModal')">
            <div class="modal-box modal-box--boards-create" onclick="event.stopPropagation()">
              <button type="button" class="mypage-boards-modal-back" onclick="closeEditBoardModal()">뒤로 가기</button>
              <h3 class="mypage-boards-modal-title">게시판 수정하기</h3>
              <p id="editBoardFormError" class="mypage-boards-form-error" role="alert"></p>
              <form id="editBoardForm" method="POST" action="">
                <input type="hidden" name="_method" value="PUT">
                <div class="form-group">
                  <label class="form-label" for="editBoardNameKo">게시판 이름 입력 (국문) <span class="required">*</span></label>
                  <input type="text" id="editBoardNameKo" name="name" class="form-input" maxlength="120" autocomplete="off">
                </div>
                <div class="form-group">
                  <label class="form-label" for="editBoardNameJa">게시판 이름 입력 (일본어) <span class="required">*</span></label>
                  <input type="text" id="editBoardNameJa" name="name_ja" class="form-input" maxlength="120" autocomplete="off">
                </div>
                <div class="form-group">
                  <label class="form-label" for="editBoardDesc">게시판에 대한 간단한 소개문 <span class="required">*</span></label>
                  <textarea id="editBoardDesc" name="description" class="form-input" rows="4" maxlength="2000"></textarea>
                </div>
                <div class="mypage-boards-modal-submit-wrap">
                  <button type="submit" class="btn-primary mypage-boards-submit-wide">수정 완료</button>
                </div>
              </form>
            </div>
          </div>

          <div id="boardDeleteConfirmModal" class="modal-overlay" style="display:none" onclick="closeModalOnOverlay(event, 'boardDeleteConfirmModal')">
            <div class="modal-box modal-box--narrow" onclick="event.stopPropagation()">
              <h3 class="modal-header" style="border:none;padding:0;margin:0 0 1rem;font-size:1.1rem">삭제하시겠습니까?</h3>
              <p class="mypage-account-muted" style="margin-bottom:1.25rem">삭제한 게시판은 복구할 수 없습니다.</p>
              <div class="modal-actions" style="justify-content:flex-end;gap:0.5rem">
                <button type="button" class="btn-secondary" onclick="closeBoardDeleteConfirm()">취소</button>
                <button type="button" class="btn-primary" style="background:#b91c1c;border-color:#b91c1c" onclick="confirmBoardDeleteSubmit()">삭제</button>
              </div>
            </div>
          </div>

          <div id="boardDeleteBlockedModal" class="modal-overlay" style="display:none" onclick="closeModalOnOverlay(event, 'boardDeleteBlockedModal')">
            <div class="modal-box modal-box--narrow" onclick="event.stopPropagation()">
              <h3 class="modal-header" style="border:none;padding:0;margin:0 0 1rem;font-size:1.05rem">삭제할 수 없음</h3>
              <p class="mypage-account-muted" style="margin-bottom:1.25rem">게시판에 게시물이 존재해 게시판을 삭제할 수 없습니다.</p>
              <div class="modal-actions" style="justify-content:flex-end">
                <button type="button" class="btn-primary" onclick="closeBoardDeleteBlocked()">확인</button>
              </div>
            </div>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <script>
    window.__MYPAGE_ACCOUNT__ = <%- JSON.stringify({
      initialNickname: typeof initialNickname !== 'undefined' ? initialNickname : profileUser.nickname,
      initialAvatar: typeof initialAvatar !== 'undefined' && initialAvatar ? initialAvatar : null,
      activeTab: activeTab
    }) %>;
  </script>
  <script src="/js/mypage-account.js?v=20260433"></script>
  <% if (activeTab === 'mainSettings') { %>
  <script>
    window.__MYPAGE_MAIN_SETTINGS__ = <%- JSON.stringify({
      site_name: (settings && settings.site_name) ? settings.site_name : 'Donghawan Lee / @lilip',
      bio: settings && settings.bio ? settings.bio : '',
      profile_image: settings && settings.profile_image ? settings.profile_image : ''
    }) %>;
  </script>
  <script src="/js/mypage-main-settings.js?v=20260433"></script>
  <% } %>
  <% if (activeTab === 'boardsManage') { %>
  <script src="/js/mypage-boards.js?v=20260511"></script>
  <% } %>
</body>
</html>
